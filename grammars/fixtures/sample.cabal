cabal-version:      2.4
name:               poly-release
version:            0.2.0
synopsis:           Parse and rank release tags
license:            BSD-3-Clause
author:             Ricky
build-type:         Simple
extra-source-files: README.md

common warnings
    ghc-options: -Wall -Wcompat -Widentifier-badges

library
    import:           warnings
    exposed-modules:  Poly.Release
    build-depends:    base >=4.17 && <5
                    , text  ^>=2.0
    hs-source-dirs:   src
    default-language: Haskell2010

test-suite spec
    import:           warnings
    type:             exitcode-stdio-1.0
    main-is:          Spec.hs
    hs-source-dirs:   test
    build-depends:    base, poly-release, hspec
    default-language: Haskell2010
