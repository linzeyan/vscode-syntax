#!/usr/bin/env python3
"""Generated by Ansible for {{ inventory_hostname }} -- do not edit."""

import os

POLY_HOST = "{{ poly_bind_address | default('127.0.0.1') }}"
POLY_PORT = {{ poly_port | int }}

TOOLS = {
{% for name, path in poly_tools.items() %}
    "{{ name }}": {{ path | tojson }},
{% endfor %}
}


def main() -> int:
    {% if poly_debug %}
    os.environ["POLY_LOG"] = "debug"
    {% endif %}
    print(f"listening on {POLY_HOST}:{POLY_PORT} with {len(TOOLS)} tools")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
