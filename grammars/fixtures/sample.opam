opam-version: "2.0"
name: "poly-release"
version: "0.2.0"
synopsis: "Parse and rank release tags"
description: """
Semver parsing plus asset bookkeeping for poly releases.
Generated by dune, edited by hand for the fixture.
"""
maintainer: ["Ricky"]
authors: ["Ricky"]
license: "BSD-3-Clause"
homepage: "https://github.com/linzeyan/vscode-syntax"
bug-reports: "https://github.com/linzeyan/vscode-syntax/issues"

depends: [
  "ocaml" {>= "4.14"}
  "dune" {>= "3.11"}
  "alcotest" {with-test}
]

build: [
  ["dune" "subst"] {dev}
  ["dune" "build" "-p" name "-j" jobs]
  ["dune" "runtest" "-p" name "-j" jobs] {with-test}
]
