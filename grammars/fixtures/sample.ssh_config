# Managed by poly -- do not edit by hand.

Host bastion
  HostName 203.0.113.10
  User deploy
  Port 2222
  IdentityFile ~/.ssh/id_ed25519
  IdentitiesOnly yes
  ForwardAgent no

Host 10.0.*.* !10.0.99.*
  ProxyJump bastion
  ControlMaster auto
  ControlPath ~/.ssh/cm-%r@%h:%p
  ControlPersist 10m
  StrictHostKeyChecking accept-new

Match host *.internal exec "test -f ~/.ssh/internal"
  UserKnownHostsFile ~/.ssh/known_hosts.internal
  SetEnv TERM=xterm-256color

Host *
  ServerAliveInterval 60      # keep NAT mappings warm
  Compression yes
  AddKeysToAgent confirm
  PreferredAuthentications "publickey,keyboard-interactive"
