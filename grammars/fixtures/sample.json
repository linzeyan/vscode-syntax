{
  "name": "poly-syntax",
  "version": "0.2.0",
  "private": true,
  "engines": { "vscode": "^1.85.0" },
  "keywords": ["syntax", "highlight", "textmate"],
  "contributes": {
    "grammars": [
      { "language": "toml", "scopeName": "source.toml", "path": "./syntaxes/toml.tmLanguage.json" }
    ]
  },
  "numbers": [0, -1, 3.14, 1e10, -2.5e-3],
  "escapes": "quote \" backslash \\ unicode é tab \t",
  "nulls": [null, true, false],
  "empty": {}
}
