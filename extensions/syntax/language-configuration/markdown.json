{
  "onEnterRules": [
    {
      "beforeText": "^\\s*- \\[[ xX]\\] .+",
      "action": { "indent": "none", "appendText": "- [ ] " }
    },
    {
      "beforeText": "^\\s*- .+",
      "action": { "indent": "none", "appendText": "- " }
    },
    {
      "beforeText": "^\\s*\\* .+",
      "action": { "indent": "none", "appendText": "* " }
    },
    {
      "beforeText": "^\\s*\\+ .+",
      "action": { "indent": "none", "appendText": "+ " }
    },
    {
      "beforeText": "^\\s*> .+",
      "action": { "indent": "none", "appendText": "> " }
    }
  ]
}
