{
  "name": "poly-editor",
  "displayName": "Poly Editor",
  "description": "Editor-side conveniences with no CI counterpart: copy path:line references in the same shape poly's diagnostics print.",
  "version": "0.9.0",
  "publisher": "ricky",
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "configuration": {
      "title": "Poly Editor",
      "properties": {
        "poly.indentTint.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Tint each level of leading whitespace, and mark whitespace that does not fill a level. Colours are the poly.indentLevel* / poly.indentPartial theme colours, overridable in workbench.colorCustomizations."
        },
        "poly.imagePreview.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Show a thumbnail in the gutter for lines that name an image file which exists."
        },
        "poly.referencesCodeLens.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Show a reference count above each declaration, and an implementation count above each interface and interface method, in every language whose reference provider can answer. Both counts come from whatever providers the language already has; poly analyses nothing. Whether clicking one opens the peek or the References panel is controlled by references.preferredLocation."
        },
        "poly.todo.tags": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "TODO",
            "FIXME",
            "HACK",
            "XXX",
            "BUG"
          ],
          "description": "Markers the TODOs view lists. Matched as whole words, case-sensitively; entries that are not plain words are ignored."
        }
      }
    },
    "colors": [
      {
        "id": "poly.indentLevel1",
        "description": "Background of the first indent level.",
        "defaults": {
          "dark": "#FFFF4012",
          "light": "#FFFF4012",
          "highContrast": "#FFFF4020"
        }
      },
      {
        "id": "poly.indentLevel2",
        "description": "Background of the second indent level.",
        "defaults": {
          "dark": "#7FFF7F12",
          "light": "#7FFF7F12",
          "highContrast": "#7FFF7F20"
        }
      },
      {
        "id": "poly.indentLevel3",
        "description": "Background of the third indent level.",
        "defaults": {
          "dark": "#FF7FFF12",
          "light": "#FF7FFF12",
          "highContrast": "#FF7FFF20"
        }
      },
      {
        "id": "poly.indentLevel4",
        "description": "Background of the fourth indent level; levels beyond it cycle.",
        "defaults": {
          "dark": "#4FECEC12",
          "light": "#4FECEC12",
          "highContrast": "#4FECEC20"
        }
      },
      {
        "id": "poly.indentPartial",
        "description": "Background of leading whitespace that does not fill an indent level.",
        "defaults": {
          "dark": "#80202099",
          "light": "#80202066",
          "highContrast": "#802020CC"
        }
      }
    ],
    "commands": [
      {
        "command": "poly.copyPathWithLine",
        "title": "Copy Path with Line Numbers",
        "category": "Poly"
      },
      {
        "command": "poly.insertTableOfContents",
        "title": "Insert Table of Contents",
        "category": "Poly"
      },
      {
        "command": "poly.toggleBold",
        "title": "Toggle Bold",
        "category": "Poly"
      },
      {
        "command": "poly.toggleItalic",
        "title": "Toggle Italic",
        "category": "Poly"
      },
      {
        "command": "poly.refreshTodos",
        "title": "Refresh TODOs",
        "category": "Poly",
        "icon": "$(refresh)"
      },
      {
        "command": "poly.extractVariable",
        "title": "Extract Variable",
        "category": "Poly"
      },
      {
        "command": "poly.inlineVariable",
        "title": "Inline Variable",
        "category": "Poly"
      },
      {
        "command": "poly.nextChangedFile",
        "title": "Go to Next Changed File",
        "category": "Poly"
      },
      {
        "command": "poly.previousChangedFile",
        "title": "Go to Previous Changed File",
        "category": "Poly"
      },
      {
        "command": "poly.revertAndSave",
        "title": "Revert Selected Changes and Save",
        "category": "Poly"
      }
    ],
    "views": {
      "explorer": [
        {
          "id": "polyTodos",
          "name": "TODOs"
        }
      ]
    },
    "menus": {
      "editor/context": [
        {
          "command": "poly.copyPathWithLine",
          "group": "9_cutcopypaste"
        }
      ],
      "view/title": [
        {
          "command": "poly.refreshTodos",
          "when": "view == polyTodos",
          "group": "navigation"
        }
      ]
    },
    "keybindings": [
      {
        "command": "poly.toggleBold",
        "key": "ctrl+b",
        "mac": "cmd+b",
        "when": "editorTextFocus && !editorReadonly && editorLangId == markdown"
      },
      {
        "command": "poly.toggleItalic",
        "key": "ctrl+i",
        "mac": "cmd+i",
        "when": "editorTextFocus && !editorReadonly && editorLangId == markdown"
      },
      {
        "command": "poly.nextChangedFile",
        "key": "ctrl+alt+z",
        "mac": "cmd+alt+z",
        "when": "config.git.enabled && !git.missing"
      },
      {
        "command": "poly.previousChangedFile",
        "key": "ctrl+alt+a",
        "mac": "cmd+alt+a",
        "when": "config.git.enabled && !git.missing"
      },
      {
        "command": "poly.revertAndSave",
        "key": "alt+q",
        "when": "editorTextFocus && !editorReadonly && config.git.enabled && !git.missing && resourceScheme == file"
      },
      {
        "command": "poly.extractVariable",
        "key": "ctrl+alt+v",
        "mac": "cmd+alt+v",
        "when": "editorTextFocus && !editorReadonly"
      },
      {
        "command": "poly.inlineVariable",
        "key": "ctrl+alt+shift+v",
        "mac": "cmd+alt+shift+v",
        "when": "editorTextFocus && !editorReadonly"
      }
    ]
  },
  "scripts": {
    "build": "esbuild src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --format=cjs --platform=node --minify",
    "typecheck": "tsc --noEmit",
    "test": "tsc -p tsconfig.test.json && node --test out/*.test.js"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/vscode": "^1.85.0",
    "esbuild": "^0.28.1",
    "typescript": "^5.4.0"
  },
  "packageManager": "pnpm@11.5.3"
}
