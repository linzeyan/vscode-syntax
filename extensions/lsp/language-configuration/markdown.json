{
  "onEnterRules": [
    {
      "beforeText": "^\\s*- \\[[ xX]\\] .+",
      "action": { "indent": "none", "appendText": "- [ ] " }
    },
    {
      "beforeText": "^\\s*\\* \\[[ xX]\\] .+",
      "action": { "indent": "none", "appendText": "* [ ] " }
    },
    {
      "beforeText": "^\\s*\\+ \\[[ xX]\\] .+",
      "action": { "indent": "none", "appendText": "+ [ ] " }
    },
    {
      "beforeText": "^\\s*\\d+\\. \\[[ xX]\\] .+",
      "action": { "indent": "none", "appendText": "1. [ ] " }
    },
    {
      "beforeText": "^\\s*\\d+\\) \\[[ xX]\\] .+",
      "action": { "indent": "none", "appendText": "1) [ ] " }
    },
    {
      "beforeText": "^\\s*- .+",
      "action": { "indent": "none", "appendText": "- " }
    },
    {
      "beforeText": "^\\s*\\* .+",
      "action": { "indent": "none", "appendText": "* " }
    },
    {
      "beforeText": "^\\s*\\+ .+",
      "action": { "indent": "none", "appendText": "+ " }
    },
    {
      "beforeText": "^\\s*\\d+\\. .+",
      "action": { "indent": "none", "appendText": "1. " }
    },
    {
      "beforeText": "^\\s*\\d+\\) .+",
      "action": { "indent": "none", "appendText": "1) " }
    },
    {
      "beforeText": "^\\s*> .+",
      "action": { "indent": "none", "appendText": "> " }
    }
  ]
}
